.local/bin/
__pycache__/

# Claude Code runtime — only CLAUDE.md and settings.json are intentional
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/statusline-usage.sh
!.claude/icons
!.claude/cut-the-crap.md

# Theme runtime state — swapped by ~/.scripts/theme-apply, sources are tracked.
.config/alacritty/colors.toml
.config/hypr/colors.lua
.config/hypr/colors-hyprlock.conf
.config/wezterm/colors.lua
.config/nvim/colors.lua
.config/gtk-3.0/settings.ini
.config/gtk-4.0/settings.ini

# duo daemon: built by `go build` in duo/, deployed via the host manifest
duo/duo

# makepkg artefacts (pkgbuilds/)
pkgbuilds/*/src/
pkgbuilds/*/pkg/
pkgbuilds/*/*.pkg.tar*
pkgbuilds/*/*.tar.xz
pkgbuilds/*/*.h
pkgbuilds/*/*.cpp
# git sources: makepkg clones them next to the PKGBUILD
pkgbuilds/*/omarchy-pods/

# Per-host runtime state — written on the machine, never shared
.config/hypr/.layout
.config/themes/wallpaper.json
.config/themes/wallpaper-mode

# nwg-displays writes these on apply; nothing sources them (lua config)
.config/hypr/monitors.conf
.config/hypr/workspaces.conf
