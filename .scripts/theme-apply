#!/usr/bin/env python3
"""theme-apply <name>  — apply ~/.config/themes/<name>.json everywhere.

One palette file per theme; this writes every per-app copy from it:
  ~/.theme.json                    quickshell (common/Theme.qml, FileView)
  ~/.theme-mode                    dark|light — nvim ThemeSync, GTK, wezterm ☀
  ~/.config/hypr/colors.lua        required by hyprland.lua
  ~/.config/hypr/colors-hyprlock.conf  sourced by hyprlock.conf
  ~/.config/alacritty/colors.toml  imported by alacritty.toml
  ~/.config/wezterm/colors.lua     required by wezterm.lua
  ~/.config/nvim/colors.lua        base16 palette read by custom/theme_sync.lua
then pokes the running apps. `dark`/`light` still work as aliases so old
callers keep going. A wallpaper-derived theme is just another json here
(wallpaper.sh regenerates themes/wallpaper.json per picture).
"""
import json, os, subprocess, sys, glob
from pathlib import Path

HOME = Path.home()
THEMES = HOME / ".config/themes"
ALIAS = {"dark": "purple", "light": "gruvbox-light"}

def rgba(hex8):  # "#RRGGBBAA" or "#RRGGBB" -> hyprland rgba(rrggbbaa)
    h = hex8.lstrip("#")
    return f"rgba({h}ff)" if len(h) == 6 else f"rgba({h})"

# --- light-mode contrast clamp ---------------------------------------------
# Light palettes are authored against a white canvas, but wezterm paints the
# background at window_background_opacity (0.50) while glyphs stay opaque — so
# the real canvas is the background blended halfway into the wallpaper, a mid
# grey. Measured there, every light theme's bright[] ramp and its greys fall to
# 1.2-2.3:1 (the unreadable dim text in Claude/gtmux). Darken anything under
# MIN_CONTRAST until it clears, against that pessimistic canvas.
# ponytail: one threshold for normal+bright, so the two ramps can collapse to
# the same lightness; split into two targets if the tiers stop reading apart.
MIN_CONTRAST = 4.5
BLEND_ALPHA = 0.5        # wezterm window_background_opacity
BLEND_OVER = (128, 128, 128)  # assumed mid-grey wallpaper

def _rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))

def _lum(rgb):
    f = lambda c: (c / 255 / 12.92) if c / 255 <= 0.04045 else ((c / 255 + 0.055) / 1.055) ** 2.4
    r, g, b = map(f, rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def _contrast(a, b):
    la, lb = _lum(a), _lum(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)

def _darken_to(hexc, canvas):
    rgb = _rgb(hexc)
    if _contrast(rgb, canvas) >= MIN_CONTRAST:
        return hexc
    k = 1.0
    while k > 0:
        scaled = tuple(round(c * k) for c in rgb)
        if _contrast(scaled, canvas) >= MIN_CONTRAST:
            return "#%02x%02x%02x" % scaled
        k -= 0.02
    return "#000000"

def clamp_light(tm):
    """Darken term fg/normal/bright until readable on the blended canvas."""
    bg = _rgb(tm["background"])
    canvas = tuple(round(b * BLEND_ALPHA + o * (1 - BLEND_ALPHA)) for b, o in zip(bg, BLEND_OVER))
    tm["foreground"] = _darken_to(tm["foreground"], canvas)
    for ramp in ("normal", "bright"):
        tm[ramp] = [_darken_to(c, canvas) for c in tm[ramp]]

def clamp_shell(sh):
    """Same for the bar/nvim-grey tokens, on the island's own (85%) canvas.
    island is #AARRGGBB; text/bright/dim also feed nvim base03-07."""
    a = int(sh["island"][1:3], 16) / 255
    bg = _rgb(sh["island"][3:])
    canvas = tuple(round(b * a + o * (1 - a)) for b, o in zip(bg, BLEND_OVER))
    for k in ("text", "bright", "dim"):
        sh[k] = _darken_to(sh[k], canvas)

def selftest():
    canvas = _rgb("#b0bab4")
    assert round(_contrast(_rgb("#ffffff"), _rgb("#000000")), 1) == 21.0
    assert _contrast(_rgb("#efdbff"), canvas) < 2          # the unreadable purple
    assert _contrast(_rgb(_darken_to("#efdbff", canvas)), canvas) >= MIN_CONTRAST
    assert _darken_to("#181c20", canvas) == "#181c20"      # already dark: untouched
    tm = {"background": "#f7f9ff", "foreground": "#181c20",
          "normal": ["#181c20"] * 8, "bright": ["#efdbff"] * 8}
    clamp_light(tm)
    assert tm["bright"][0] != "#efdbff" and tm["normal"][0] == "#181c20"
    sh = {"island": "#D9f1f3f9", "text": "#42474e", "bright": "#181c20", "dim": "#BDAE93"}
    clamp_shell(sh)
    assert sh["dim"] != "#BDAE93" and sh["bright"] == "#181c20"
    print("ok")

def main():
    if len(sys.argv) == 2 and sys.argv[1] == "--selftest":
        return selftest()
    if len(sys.argv) != 2:
        names = sorted(p.stem for p in THEMES.glob("*.json"))
        sys.exit(f"usage: theme-apply <{'|'.join(names)}>")
    name = ALIAS.get(sys.argv[1], sys.argv[1])
    src = THEMES / f"{name}.json"
    if not src.exists() and name == "wallpaper":
        # wallpaper.json is per-host generated state (untracked); before the
        # first wallpaper pick on a fresh host, fall back to the dark default
        name = ALIAS["dark"]
        src = THEMES / f"{name}.json"
    if not src.exists():
        sys.exit(f"no theme {src}")
    t = json.loads(src.read_text())
    mode = t.get("mode", "dark")
    sh, hy, tm = t["shell"], t["hypr"], t["term"]
    if mode == "light":
        clamp_light(tm)
        clamp_shell(sh)

    (HOME / ".theme.json").write_text(json.dumps({"name": name, "mode": mode, **sh}, indent=2))
    (HOME / ".theme-mode").write_text(mode + "\n")

    q = lambda s: f'"{s}"'
    (HOME / ".config/hypr/colors.lua").write_text(f"""-- generated by ~/.scripts/theme-apply from themes/{name}.json — do not edit
hl.config({{
    general = {{
        col = {{
            active_border   = {{ colors = {{ {", ".join(map(q, hy["active_border"]))} }}, angle = 45 }},
            inactive_border = {q(hy["inactive_border"])},
        }},
    }},
    group = {{
        col = {{
            border_active          = {q(hy["group_active"])},
            border_inactive        = {q(hy["group_inactive"])},
            border_locked_active   = {q(hy["group_locked_active"])},
            border_locked_inactive = {q(hy["group_locked_inactive"])},
        }},
        groupbar = {{
            enabled             = true,
            height              = 28,
            font_size           = 13,
            gradients           = false,
            render_titles       = true,
            scrolling           = true,
            gaps_in             = 0,
            gaps_out            = 0,
            text_color_inactive = {q(hy["groupbar_text_inactive"])},
            text_color          = {q(hy["groupbar_text"])},
            col = {{
                active          = {q(hy["groupbar_active"])},
                inactive        = {q(hy["groupbar_inactive"])},
                locked_active   = {q(hy["groupbar_locked_active"])},
                locked_inactive = {q(hy["groupbar_locked_inactive"])},
            }},
        }},
    }},
}})
""")

    # hyprlock reads its config at launch, so no poke needed — the next lock
    # picks the new colors up. All 6-digit palette entries; the alpha-first
    # island/surface tokens stay out (hyprlang rgba() wants RRGGBBAA).
    (HOME / ".config/hypr/colors-hyprlock.conf").write_text(f"""# generated by ~/.scripts/theme-apply from themes/{name}.json — do not edit
$bg = {rgba(tm["background"])}
$fg = {rgba(tm["foreground"])}
$dim = {rgba(sh["dim"])}
$accent = {rgba(sh["accent"])}
$urgent = {rgba(sh["urgent"])}
""")

    ansi = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    block = lambda cs: "\n".join(f'{n:<7} = "{c}"' for n, c in zip(ansi, cs))
    (HOME / ".config/alacritty/colors.toml").write_text(f"""# generated by ~/.scripts/theme-apply from themes/{name}.json — do not edit

[colors]
draw_bold_text_with_bright_colors = true

[colors.primary]
background = "{tm["background"]}"
foreground = "{tm["foreground"]}"

[colors.cursor]
text = "{tm["cursor_text"]}"
cursor = "{tm["cursor"]}"

[colors.selection]
text = "{tm["selection_text"]}"
background = "{tm["selection"]}"

[colors.normal]
{block(tm["normal"])}

[colors.bright]
{block(tm["bright"])}
""")

    lua = lambda cs: ", ".join(f"'{c}'" for c in cs)
    (HOME / ".config/wezterm/colors.lua").write_text(f"""-- generated by ~/.scripts/theme-apply from themes/{name}.json — do not edit
return {{
  mode = '{mode}',
  titlebar = '{tm["titlebar"]}',
  colors = {{
    foreground = '{tm["foreground"]}',
    background = '{tm["background"]}',
    cursor_bg = '{tm["cursor"]}',
    cursor_fg = '{tm["cursor_text"]}',
    selection_bg = '{tm["selection"]}',
    selection_fg = '{tm["selection_text"]}',
    ansi = {{ {lua(tm["normal"])} }},
    brights = {{ {lua(tm["bright"])} }},
  }},
}}
""")

    # base16 from the palette: ansi hues for base08-0F, shell greys for base00-07.
    b16 = [tm["background"], sh["track"], tm["selection"], sh["dim"],
           sh["text"], tm["foreground"], sh["bright"], sh["bright"],
           tm["normal"][1], sh["accent"], tm["normal"][3], tm["normal"][2],
           tm["normal"][6], tm["normal"][4], tm["normal"][5], tm["bright"][1]]
    (HOME / ".config/nvim/colors.lua").write_text(
        f"-- generated by ~/.scripts/theme-apply from themes/{name}.json — do not edit\n"
        f"return {{\n  mode = '{mode}',\n  palette = {{\n"
        + "".join(f"    base{i:02X} = '{c}',\n" for i, c in enumerate(b16))
        + "  },\n}\n")

    # ---- poke the running apps ----
    run = lambda *a: subprocess.run(a, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.utime(HOME / ".config/alacritty/alacritty.toml")   # live-reloads on mtime
    os.utime(HOME / ".config/wezterm/wezterm.lua")
    run("hyprctl", "reload")
    for s in glob.glob(f"/run/user/{os.getuid()}/nvim.*"):
        run("timeout", "3", "nvim", "--server", s, "--remote-expr", f"execute('ThemeSync {mode}')")

    dark = mode == "dark"
    gtk_theme = "Materia-dark-compact" if dark else "Materia-light-compact"
    scheme = "prefer-dark" if dark else "prefer-light"
    ini = f"""[Settings]
gtk-theme-name={gtk_theme}
gtk-icon-theme-name=Adwaita
gtk-font-name=Adwaita Sans 11
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=0
gtk-toolbar-style=GTK_TOOLBAR_BOTH_HORIZ
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=0
gtk-menu-images=0
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
gtk-application-prefer-dark-theme={1 if dark else 0}
gtk-color-scheme={scheme}
"""
    for d in ("gtk-3.0", "gtk-4.0"):
        p = HOME / ".config" / d / "settings.ini"
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(ini)
    run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme)
    run("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk_theme)
    run("gsettings", "set", "org.mate.interface", "gtk-theme", gtk_theme)
    for prop, typ, val in (("/Net/ThemeName", "string", gtk_theme), ("/Net/IconThemeName", "string", "Adwaita"),
                           ("/Gtk/CursorThemeName", "string", "Adwaita"), ("/Gtk/CursorThemeSize", "int", "0")):
        run("xfconf-query", "-c", "xsettings", "-p", prop, "-n", "-t", typ, "-s", val)
    # Thunar does not repaint on theme change; bounce it if running
    if subprocess.run(["pgrep", "-x", "thunar"], stdout=subprocess.DEVNULL).returncode == 0:
        run("thunar", "--quit")
        subprocess.Popen(["setsid", "thunar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(name)

if __name__ == "__main__":
    main()
