#!/usr/bin/env bash
# Look toggles, persisted across reboots:
#   glass         hyprglass on the shell and terminal (off: stock blur instead)
#   transparency  every blur and see-through surface (off: all opaque, wins over glass)
# Each flag is a 1/0 file under $XDG_STATE_HOME/glass; missing means 1.
# Readers: hypr/plugins.lua (on config load), quickshell common/Sys.qml and
# wezterm.lua (both watch the files), .scripts/powersave (on leaving ultra).
set -euo pipefail

DIR="${XDG_STATE_HOME:-$HOME/.local/state}/glass"
usage() { echo "usage: glass {glass|transparency} [on|off|toggle|status]" >&2; exit 2; }
get() { [ "$(cat "$DIR/$1" 2>/dev/null)" = 0 ] && echo 0 || echo 1; }

case "${1:-}" in glass|transparency) ;; *) usage ;; esac
cur=$(get "$1")
case "${2:-toggle}" in
  on) new=1 ;;
  off) new=0 ;;
  toggle) new=$((1 - cur)) ;;
  status) [ "$cur" = 1 ] && echo on || echo off; exit ;;
  *) usage ;;
esac

# Both files always exist after a write: quickshell's FileView and wezterm's
# reload watch only track files that are there.
mkdir -p "$DIR"
g=$(get glass) t=$(get transparency)
echo "$g" > "$DIR/glass"; echo "$t" > "$DIR/transparency"
echo "$new" > "$DIR/$1"

# Ultra power-save already has all of it off; leaving it re-applies these flags.
# Otherwise a reload: plugins.lua reads the flags (misc.disable_autoreload is on).
[ "$(cat "${XDG_RUNTIME_DIR:-/tmp}/ultrasave" 2>/dev/null)" = 1 ] || hyprctl reload >/dev/null
