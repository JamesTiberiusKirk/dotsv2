#!/usr/bin/env bash
# Ultra power-save toggle: everything power-profiles-daemon's power-saver does
# not touch. Sudoless — the intel_pstate nodes are group-writable via
# system/etc/udev/rules.d/91-intel-pstate-video.rules.
set -euo pipefail

MAX_PERF=50   # % of max CPU freq while on — the calibration knob
STATE="${XDG_RUNTIME_DIR:-/tmp}/ultrasave"
PSTATE=/sys/devices/system/cpu/intel_pstate

wifi_con() { nmcli -t -f NAME,TYPE con show --active | awk -F: '$2=="802-11-wireless"{print $1; exit}'; }

# Drop every monitor to the lowest refresh rate its current resolution offers.
# Portable across hosts (binstar 120→60, dellstar/legion whatever their panel
# has); `off` reverts via hyprctl reload, which re-applies the config rules.
min_hz_monitors() {
  hyprctl monitors -j | jq -r '.[] | select(.disabled | not)
    | "\(.width)x\(.height)" as $res
    | (.availableModes | map((capture("^\($res)@(?<hz>[0-9.]+)Hz")? | .hz | tonumber)) | min) as $hz
    | select($hz != null)
    | "hl.monitor({ output = \"\(.name)\", mode = \"\(.width)x\(.height)@\($hz)\", position = \"\(.x)x\(.y)\", scale = \(.scale) })"'
}

on() {
  powerprofilesctl set power-saver
  # intel_pstate only exists on intel; AMD boxes get the profile switch alone
  [ -w $PSTATE/no_turbo ] && echo 1 > $PSTATE/no_turbo
  [ -w $PSTATE/max_perf_pct ] && echo $MAX_PERF > $PSTATE/max_perf_pct
  # lua config: `hyprctl keyword` is a no-op, hl.* through eval is the live path
  hyprctl eval "$(min_hz_monitors)
    hl.config({ decoration = { blur = { enabled = false }, shadow = { enabled = false } },
                animations = { enabled = false } })" >/dev/null
  w=$(wifi_con); [ -z "$w" ] || nmcli con modify "$w" wifi.powersave 3
  touch "$STATE"
}

off() {
  [ -w $PSTATE/no_turbo ] && echo 0 > $PSTATE/no_turbo
  [ -w $PSTATE/max_perf_pct ] && echo 100 > $PSTATE/max_perf_pct
  hyprctl reload >/dev/null          # one call reverts everything eval set above
  w=$(wifi_con); [ -z "$w" ] || nmcli con modify "$w" wifi.powersave 2
  powerprofilesctl set "${1:-balanced}"
  rm -f "$STATE"
}

case "${1:-toggle}" in
  on) on ;;
  off) off "${2:-}" ;;
  status) [ -f "$STATE" ] && echo on || echo off ;;
  toggle) [ -f "$STATE" ] && off || on ;;
  *) echo "usage: powersave [on|off [profile]|toggle|status]" >&2; exit 2 ;;
esac
