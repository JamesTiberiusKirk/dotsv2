#!/bin/sh
# Cycle to the next theme in ~/.config/themes (alphabetical, wraps).
set -eu
cur=$(python3 -c 'import json;print(json.load(open("'"$HOME"'/.theme.json"))["name"])' 2>/dev/null || echo purple)
set -- $(ls "$HOME/.config/themes"/*.json | xargs -n1 basename | sed 's/\.json$//')
next=$1
while [ $# -gt 0 ]; do
    if [ "$1" = "$cur" ]; then shift; next=${1:-$next}; break; fi
    shift
done
exec "$HOME/.scripts/theme-apply" "$next"
