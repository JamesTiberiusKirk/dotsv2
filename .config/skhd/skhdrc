# Alt + vim keys → arrow keys (built-in keyboard navigation layer)
# Caps Lock → Ctrl: set per-device in System Settings > Keyboard > Modifier Keys
alt - h : skhd -k "left"
alt - l : skhd -k "right"
alt - k : skhd -k "up"
alt - j : skhd -k "down"

# Swap workspaces between monitors (suppresses macOS app switcher).
# cmd-tab enters swap mode; h/j/k/l swap with the monitor in that direction;
# esc/return exits back to normal.
:: swap @

cmd - tab ; swap

swap < h : ~/.scripts/swap-workspaces-mac.sh left
swap < l : ~/.scripts/swap-workspaces-mac.sh right
swap < k : ~/.scripts/swap-workspaces-mac.sh up
swap < j : ~/.scripts/swap-workspaces-mac.sh down
swap < escape ; default
swap < return ; default

# Screenshot selection → clipboard (remaps Cmd+Shift+4 behaviour)
cmd + shift - s : screencapture -i -u ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png
