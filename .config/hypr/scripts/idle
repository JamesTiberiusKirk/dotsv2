#!/usr/bin/env bash
# Idle ladder (hypridle): lock -> screen off -> suspend, each stage its own
# timeout, settable from the bar's display panel.
#
# Settings live in ~/.local/state/idle/settings (key=value); hypridle.conf is
# generated from them next to it and hypridle runs against that file, so the
# repo carries no hypridle config to drift from the state. Any settings change
# regenerates + restarts hypridle (it has no live reload; restart is instant).
#
# "keep awake" drops the timeout listeners but keeps hypridle alive: the
# general block's before_sleep_cmd must keep locking ahead of any suspend
# (lid, manual bind), or waking from an awake-mode sleep lands on an unlocked
# desktop. The flag lives in the runtime dir so a fresh login starts managed.
#
# "timer" is a one-shot sleep timer (the `sleep 2h && loginctl suspend` you'd
# type by hand), separate from the ladder: it fires even in keep-awake mode.
# It waits on a wall-clock deadline, not `sleep N`, because sleep's clock
# stops while the machine is suspended, so a lid-close would push it back.
# pid/deadline/action live in the runtime dir: it outlives a shell restart,
# not a logout.
#
# Usage: idle [start|stop|apply|status|set <lock|screen|suspend> <min>|on|off <stage>|awake <on|off>|timer <min> <suspend|hibernate>|timer off]
set -u

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/idle"
SETTINGS="$STATE/settings"
CONF="$STATE/hypridle.conf"
LOG="$STATE/hypridle.log"  # appended across restarts so a missed screen-off can be traced after the fact
AWAKE="${XDG_RUNTIME_DIR:-/tmp}/idle-awake"
TIMER="${XDG_RUNTIME_DIR:-/tmp}/idle-timer"  # "pid deadline action"

# defaults; overridden by the settings file
lock=5      lock_on=1
screen=10   screen_on=1
suspend=30  suspend_on=0  # off by default: incoming ssh/remote sessions make no seat input

load() {
    # shellcheck disable=SC1090  # trusted key=value file we wrote ourselves
    [ -r "$SETTINGS" ] && . "$SETTINGS"
}

save() {
    mkdir -p "$STATE"
    printf '%s=%s\n' lock "$lock" lock_on "$lock_on" \
        screen "$screen" screen_on "$screen_on" \
        suspend "$suspend" suspend_on "$suspend_on" >"$SETTINGS"
}

gen() {
    mkdir -p "$STATE"
    {
        printf 'general {\n'
        printf '    lock_cmd = flock -n ${XDG_RUNTIME_DIR:-/tmp}/hyprlock.lock hyprlock\n'
        # dpms takes { action = ... }: a bare "off"/"on" string is silently a
        # per-monitor toggle, which drifts the screens out of sync for good.
        # flock, not pidof: PrepareForSleep arrives twice per sleep, so pidof
        # raced and left hung hyprlocks that then blocked every later lock.
        # hypridle is the one owner of sleep (quickshell used to blank the
        # screens too, on its own dbus watch). Screens off before going down:
        # on hibernate the GPU thaws to write the image and would light the
        # frozen desktop for ~30s. After waking, re-run the screen layout: a
        # monitor plugged or pulled during sleep arrives while DPMS is off, and
        # the hotplug watcher ignores events then.
        printf '    before_sleep_cmd = loginctl lock-session; hyprctl dispatch '\''hl.dsp.dpms({ action = "off" })'\''\n'
        printf '    after_sleep_cmd = hyprctl dispatch '\''hl.dsp.dpms({ action = "on" })'\''; ~/.config/hypr/scripts/monitor-layout.sh\n'
        printf '}\n'
        if [ ! -e "$AWAKE" ]; then
            [ "$lock_on" = 1 ] && printf 'listener {\n    timeout = %s\n    on-timeout = loginctl lock-session\n}\n' $((lock * 60))
            [ "$screen_on" = 1 ] && printf 'listener {\n    timeout = %s\n    on-timeout = hyprctl dispatch '\''hl.dsp.dpms({ action = "off" })'\''\n    on-resume = hyprctl dispatch '\''hl.dsp.dpms({ action = "on" })'\''; ~/.config/hypr/scripts/monitor-layout.sh\n}\n' $((screen * 60))
            [ "$suspend_on" = 1 ] && printf 'listener {\n    timeout = %s\n    on-timeout = loginctl suspend\n}\n' $((suspend * 60))
        fi
    } >"$CONF"
}

running() { pgrep -x hypridle >/dev/null 2>&1; }

start() {
    running && return 0
    command -v hypridle >/dev/null 2>&1 || { notify-send "hypridle not installed" 2>/dev/null || true; exit 1; }
    gen
    nohup hypridle -c "$CONF" >>"$LOG" 2>&1 &
}

stop() { running && pkill -x hypridle; return 0; }

apply() { gen; if running; then stop; sleep 0.1; nohup hypridle -c "$CONF" >>"$LOG" 2>&1 & fi; }

clampmin() { # minutes: 1..max ($3, default 180), garbage -> default given in $2
    local v=$1 max=${3:-180}
    case $v in '' | *[!0-9]*) v=$2 ;; esac
    [ "$v" -lt 1 ] && v=1
    [ "$v" -gt "$max" ] && v=$max
    printf '%s' "$v"
}

# prints "pid deadline action" of a live timer, nothing (and cleans up) otherwise
timer_get() {
    local pid end act
    [ -r "$TIMER" ] && read -r pid end act <"$TIMER" || return 1
    if kill -0 "$pid" 2>/dev/null; then printf '%s %s %s\n' "$pid" "$end" "$act"; else rm -f "$TIMER"; return 1; fi
}

timer_off() {
    local t
    t=$(timer_get) && kill "${t%% *}" 2>/dev/null
    rm -f "$TIMER"
}

timer_on() { # $1 minutes, $2 suspend|hibernate
    local min end
    min=$(clampmin "$1" 120 480)
    case "$2" in suspend | hibernate) ;; *) echo "idle timer: want suspend|hibernate" >&2; exit 1 ;; esac
    timer_off
    end=$(($(date +%s) + min * 60))
    # the loop's leftover `sleep 30` outlives a kill by <30s; harmless
    nohup sh -c 'while [ "$(date +%s)" -lt "$1" ]; do sleep 30; done; rm -f "$3"; loginctl "$2"' \
        idle-timer "$end" "$2" "$TIMER" >/dev/null 2>&1 &
    printf '%s %s %s\n' "$!" "$end" "$2" >"$TIMER"
}

load
case "${1:-status}" in
start) start ;;
stop) stop ;;
apply) apply ;;
set)
    case "${2:-}" in
    lock) lock=$(clampmin "${3:-}" 5); lock_on=1 ;;
    screen) screen=$(clampmin "${3:-}" 10); screen_on=1 ;;
    suspend) suspend=$(clampmin "${3:-}" 30); suspend_on=1 ;;
    *) echo "idle set: want lock|screen|suspend <min>" >&2; exit 1 ;;
    esac
    save; apply
    ;;
on | off)
    v=$([ "$1" = on ] && echo 1 || echo 0)
    case "${2:-}" in
    lock) lock_on=$v ;;
    screen) screen_on=$v ;;
    suspend) suspend_on=$v ;;
    *) echo "idle $1: want lock|screen|suspend" >&2; exit 1 ;;
    esac
    save; apply
    ;;
awake)
    case "${2:-on}" in on) touch "$AWAKE" ;; *) rm -f "$AWAKE" ;; esac
    if running; then apply; else start; fi
    ;;
timer)
    case "${2:-}" in off) timer_off ;; *) timer_on "${2:-}" "${3:-suspend}" ;; esac
    ;;
status)
    printf 'running=%s\n' "$(running && echo 1 || echo 0)"
    if t=$(timer_get); then
        read -r _ end act <<<"$t"
        printf 'timer_end=%s\ntimer_action=%s\n' "$end" "$act"
    else
        printf 'timer_end=0\n'
    fi
    printf 'awake=%s\n' "$([ -e "$AWAKE" ] && echo 1 || echo 0)"
    printf '%s=%s\n' lock "$lock" lock_on "$lock_on" \
        screen "$screen" screen_on "$screen_on" \
        suspend "$suspend" suspend_on "$suspend_on"
    ;;
*)
    echo "idle: want start|stop|apply|status|set <stage> <min>|on|off <stage>|awake on|off|timer <min> <action>|timer off" >&2
    exit 1
    ;;
esac
