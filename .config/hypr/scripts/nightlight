#!/usr/bin/env bash
# Night light, via hyprsunset.
#
# On/off is the daemon's lifetime, not its identity mode. hyprsunset has live
# IPC for temperature (`hyprctl hyprsunset temperature 4200` applies at once)
# but no way to read back whether a shift is currently applied — after
# `identity` it still reports the old temperature. So "is the process running"
# is the only honest state signal, and that is what the bar and the menu read.
#
# Usage: nightlight [toggle|on|off|set <K>|status]
set -u

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nightlight"
TEMP_FILE="$STATE/temp"
DEFAULT=3500
MIN=2500   # heavy amber
MAX=6500   # neutral daylight, i.e. no visible shift

clamp() {
    local t=$1
    case $t in '' | *[!0-9]*) t=$DEFAULT ;; esac
    [ "$t" -lt "$MIN" ] && t=$MIN
    [ "$t" -gt "$MAX" ] && t=$MAX
    printf '%s' "$t"
}

temp() { clamp "$(cat "$TEMP_FILE" 2>/dev/null || echo $DEFAULT)"; }
running() { pgrep -x hyprsunset >/dev/null 2>&1; }

start() {
    running && return 0
    if ! command -v hyprsunset >/dev/null 2>&1; then
        notify-send "hyprsunset not installed" >/dev/null 2>&1 || true
        exit 1
    fi
    nohup hyprsunset -t "$(temp)" >/dev/null 2>&1 &
}

stop() {
    running && pkill -x hyprsunset >/dev/null 2>&1
    return 0
}

case "${1:-toggle}" in
on) start ;;
off) stop ;;
toggle) if running; then stop; else start; fi ;;
set)
    t=$(clamp "${2:-$DEFAULT}")
    mkdir -p "$STATE"
    printf '%s\n' "$t" >"$TEMP_FILE"
    # Setting a temperature turns it on: the number means nothing while
    # nothing is applying it, and reaching for the slider is a request to see
    # the change now.
    if running; then
        hyprctl hyprsunset temperature "$t" >/dev/null 2>&1
    else
        start
    fi
    ;;
status)
    if running; then printf 'on %s\n' "$(temp)"; else printf 'off %s\n' "$(temp)"; fi
    ;;
*)
    echo "nightlight: want toggle|on|off|set <K>|status" >&2
    exit 1
    ;;
esac
